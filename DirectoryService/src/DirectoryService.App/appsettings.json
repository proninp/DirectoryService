{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "DbSettings": {
    "Host": "localhost",
    "Port": "5434",
    "Database": "directory_service_db",
    "Username": "postgres",
    "Password": ""
  },
  "SoftDeletionCleanupRetention": {
    "Interval": "00:10:00",
    "Timeout": "00:00:20",
    "RetentionDays": 60,
    "BatchSize": 500,
    "Enable": true
  }
}
